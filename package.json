{
  "name": "master-the-sticks",
  "version": "0.1.0",
  "private": true,
  "description": "Learn RC radio stick control the way you learn typing.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node node_modules/electron/install.js",
    "icon": "electron tools/build-icon.cjs",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": "Karthik",
  "build": {
    "appId": "com.masterthesticks.app",
    "productName": "Master the Sticks",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Master the Sticks ${version}",
      "artifactName": "Master-the-Sticks-${version}-${arch}.${ext}"
    }
  }
}
